# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Backups this toolkit writes
*.bak
*.orig
*.rej
*~

# Build / packaging output
build/
dist/
*.egg-info/
.eggs/
wheelhouse/

# Virtual environments
.venv/
venv/
env/

# Node dependency trees. The DSH plugin half (`lib/`) has no runtime
# dependencies of its own — it imports the host's @deepseek-ai/* packages as
# peers. A local node_modules exists only to run the JS smoke test, and it is a
# junction into the installed profile, so it must never be committed.
node_modules/

# JS smoke-test scratch.
/_smoke.mjs

# Editors
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Local-only material. These never go into the repository.
# ---------------------------------------------------------------------------

# A real game used for end-to-end testing. Several GB, and the game's content
# is not ours to redistribute.
/test/

# First-hand evidence collected while reverse-engineering engine behaviour:
# session transcripts, probes, and a complete set of finished translations for
# a third-party game.
/_evidence/

# Scratch output from `tl gen`, probe dumps, temporary copies.
/_scratch/
/_probe_dir/
/_decomp_test/
/_rtk-probe-test/
/rtk-probe-test/
/.acl-recovery/

# A translation workspace belongs to one specific title (terminology,
# character notes, translation rules). Useful material, but not general.
/work/

# `tl gen` writes its probe and dump here, inside the game directory.
.renpy-toolkit-gen/

# Format probing output. The write-up and the hand-written samples belong in
# the repository; full dumps of a real game's script do not — those are a third
# party's dialogue, tens of megabytes of it, and not ours to redistribute.
/_fmt_demo/tl_raw/
/_fmt_demo/tl_nb/
/_fmt_demo/tl_ledger/
/_fmt_demo/tl_gen*/

# One-off probes used while writing that report. Each hardcodes a local path to
# the game being probed, so they are useless (and leaky) anywhere else.
/_fmt_demo/t_*.py

# Local game paths and per-machine settings.
/local.conf
*.local

# Archives and compiled game scripts: large, and usually third-party content.
*.rpa
*.rpyc
*.rpymc
*.rpyb
# 提交信息临时文件（避免被 git add -A 带进提交）
_commitmsg*.txt
_msg*.txt
_m.txt
_dist/release-notes-*.md

# 一次性探针脚本：都写死了本机绝对路径和被测游戏位置，属于本地取证工具，
# 不是发布内容。留在工作区随便跑，但不进版本库。
/_*.py

# 过程目录（规划文档、草稿、临时脚本）与确认可丢弃的产物。
/工作区域/
/可清理文件/

# 解包与清单的临时产物。
/_dec/
/_rpalist.txt

# 安全审查记录只留本地，不随仓库发布。
/docs/security-audit.md

/renpy-toolkit-数据/

/_MEI*/
/_t/

/renpy-toolkit-*.log
# 忽略 exe/ 下运行时产生的数据目录与日志（构建/自检会造出来）
/exe/renpy-toolkit-数据/
/exe/renpy-toolkit-*.log
